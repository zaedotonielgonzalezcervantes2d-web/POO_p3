from estudiantes import estudiantes
from tkinter import Label, Entry, Button, Tk, StringVar, messagebox


class App:
    def __init__(self, ventana):
        self.ventana = ventana
        self.ventana.title("Gestión de Estudiantes")
        self.ventana.geometry("600x700")
        self.ventana.resizable(0, 0)
        self.main()

    def borrarPantalla(self):
        for widget in self.ventana.winfo_children():
            widget.destroy()

    def menu_acciones(self):
        self.borrarPantalla()
        tipo = "Estudiantes"
        Label(self.ventana, text=f"\n...::: Menu de {tipo} :::... \n").pack(pady=10)
        Button(self.ventana, text="1.- Agregar", command=self.insertar_view).pack(pady=5)
        Button(self.ventana, text="2.- Borrar", command=self.eliminar_view).pack(pady=5)
        Button(self.ventana, text="3.- Modificar", command=self.modificar_view).pack(pady=5)
        Button(self.ventana, text="4.- Mostrar", command=self.consultar_view).pack(pady=5)
        Button(self.ventana, text="5.- Regresar", command=self.main).pack(pady=5)

    def main(self):
        self.borrarPantalla()
        Label(self.ventana, text="\n...::: M E N U   P R I N C I P A L :::...").pack(pady=10)
        Button(self.ventana, text="1.- Estudiantes", command=self.menu_acciones).pack(pady=5)
        Button(self.ventana, text="2.- Salir", command=self.ventana.quit).pack(pady=5)

    def insertar_view(self):
        self.borrarPantalla()
        Label(self.ventana, text="...Ingresar los datos del Estudiante...").pack(pady=10)

        Label(self.ventana, text="Nombre: ").pack(pady=5)
        self.nombre = Entry(self.ventana)
        self.nombre.focus()
        self.nombre.pack(pady=5)

        Label(self.ventana, text="Nota: ").pack(pady=5)
        self.nota = Entry(self.ventana)
        self.nota.pack(pady=5)

        Button(self.ventana, text="Guardar", command=lambda: {self.insertar_controller(), self.insertar_view()}).pack(pady=10)
        Button(self.ventana, text="Regresar", command=self.menu_acciones).pack(pady=5)

    def eliminar_view(self):
        self.borrarPantalla()
        Label(self.ventana, text="...Ingresar el ID del Estudiante a Eliminar...").pack(pady=10)

        Label(self.ventana, text="ID: ").pack(pady=5)
        self.id = Entry(self.ventana)
        self.id.focus()
        self.id.pack(pady=5)

        self.btn_buscar = Button(self.ventana, text="Buscar", command=lambda: self.buscar_controller("eliminar"))
        self.btn_buscar.pack(pady=5)

        self.btn_eliminar = Button(self.ventana, text="Eliminar", state="disabled",
                                   command=lambda: {self.eliminar_controller(), self.eliminar_view()})
        self.btn_eliminar.pack(pady=5)

        Button(self.ventana, text="Regresar", command=self.menu_acciones).pack(pady=5)

    def modificar_view(self):
        self.borrarPantalla()
        Label(self.ventana, text="...Ingresar el ID del Estudiante a modificar...").pack(pady=10)

        Label(self.ventana, text="ID: ").pack(pady=5)
        self.id = Entry(self.ventana)
        self.id.focus()
        self.id.pack(pady=5)

        self.btn_buscar = Button(self.ventana, text="Buscar", command=lambda: self.buscar_controller("modificar"))
        self.btn_buscar.pack(pady=5)

        self.var_nombre = StringVar()
        self.var_nota = StringVar()

        Label(self.ventana, text="Nuevo Nombre: ").pack(pady=5)
        self.nombre = Entry(self.ventana, textvariable=self.var_nombre)
        self.nombre.pack(pady=5)

        Label(self.ventana, text="Nueva Nota: ").pack(pady=5)
        self.nota = Entry(self.ventana, textvariable=self.var_nota)
        self.nota.pack(pady=5)

        self.btn_modificar = Button(self.ventana, text="Guardar", state="disabled",
                                    command=lambda: {self.modificar_controller(), self.modificar_view()})
        self.btn_modificar.pack(pady=10)

        Button(self.ventana, text="Regresar", command=self.menu_acciones).pack(pady=5)

    def consultar_view(self):
        self.borrarPantalla()
        Label(self.ventana, text=" ::: Consultar los Estudiantes :::").pack(pady=10)
        filas = ""
        filas = self.consultar_controller(filas)
        fuente = ("Courier", 10)
        Label(self.ventana, font=fuente, text=f"{'Nombre':<25}{'Nota':<10}").pack(pady=5)
        Label(self.ventana, text="-" * 35, font=fuente).pack(pady=5)
        Label(self.ventana, text=f"{filas}", font=fuente, justify="left").pack(pady=5)
        Label(self.ventana, text="-" * 35, font=fuente).pack(pady=5)
        Button(self.ventana, text="Regresar", command=self.menu_acciones).pack(pady=5)

    def cambiar_estado_btn(self, estado, tipo_accion):
        nuevo_estado = "normal" if estado else "disabled"
        if tipo_accion == "eliminar":
            self.btn_eliminar.config(state=nuevo_estado)
        elif tipo_accion == "modificar":
            self.btn_modificar.config(state=nuevo_estado)

    def confirmacion_eliminar(self, tipo):
        resp = messagebox.askquestion(title="...¡Atención!...", message=f"...¿Desea {tipo} este registro?...")
        return resp == "yes"

    # ... Controlador de Estudiantes ...
    def respuesta_sql(self, respuesta):
        if respuesta:
            messagebox.showinfo(title="... Exitoso ...", message="...¡Acción realizada con éxito!...")
        else:
            messagebox.showerror(title="...¡ Verifica por favor !...",
                                 message="...¡Esta acción no pudo realizarse en este momento!...")

    def insertar_controller(self):
        nombre = self.nombre.get().strip().upper()
        nota = self.nota.get().strip()
        if not nombre or not nota:
            messagebox.showwarning(title="...¡Atención!...", message="...Completa todos los campos...")
            return
        estudiante1 = estudiantes.Estudiantes(nombre, nota)
        respuesta = estudiante1.insertar()
        self.respuesta_sql(respuesta)
        del estudiante1

    def eliminar_controller(self):
        id = self.id.get().strip()
        resp = self.confirmacion_eliminar("eliminar")
        if resp:
            respuesta = estudiantes.Estudiantes.eliminar(id)
        else:
            respuesta = False
        self.respuesta_sql(respuesta)

    def consultar_controller(self, filas):
        registros = estudiantes.Estudiantes.consultar()
        if len(registros) > 0:
            for fila in registros:
                filas = filas + f"\n{fila[1]:<25}{fila[2]:<10}"
        else:
            filas = "... ¡No existen datos que mostrar por el momento ...!"
        return filas

    def modificar_controller(self):
        id = self.id.get().strip()
        nombre = self.nombre.get().strip().upper()
        nota = self.nota.get().strip()
        if not nombre or not nota:
            messagebox.showwarning(title="...¡Atención!...", message="...Completa todos los campos...")
            return
        estudiante1 = estudiantes.Estudiantes(nombre, nota)
        respuesta = estudiante1.actualizar(nombre, nota, id)
        self.respuesta_sql(respuesta)
        del estudiante1

    def buscar_controller(self, tipo_accion):
        id = self.id.get().strip()
        estudiante1 = estudiantes.Estudiantes.buscar(id)
        if len(estudiante1) > 0:
            messagebox.showinfo(title="...¡ Registro Encontrado !...",
                                message=f"...¡El registro fue encontrado con éxito, puedes {tipo_accion}!...")
            self.cambiar_estado_btn(True, tipo_accion)
            if tipo_accion == "modificar":
                self.var_nombre.set(estudiante1[0][1])
                self.var_nota.set(estudiante1[0][2])
        else:
            messagebox.showerror(title="...¡ Verifica por favor !...",
                                 message=f"...¡El registro no fue encontrado, no es posible {tipo_accion}!...")
            self.cambiar_estado_btn(False, tipo_accion)


if __name__ == "__main__":
    ventana = Tk()
    app = App(ventana)
    ventana.mainloop()
